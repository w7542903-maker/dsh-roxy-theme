{
  "name": "dsh-roxy-theme",
  "version": "1.0.0",
  "description": "Roxy (洛琪希) crystal-glass theme for DeepSeek Harness — a selectable theme layer (light & dark palettes, glass shadows, brand accents) plus a Roxy settings page. A DSH web plugin.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "styles",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node tests/client.test.mjs && node tests/host.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "roxy",
    "洛琪希",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w7542903-maker/dsh-roxy-theme.git"
  },
  "homepage": "https://github.com/w7542903-maker/dsh-roxy-theme#readme",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
